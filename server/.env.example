# ============================================================
# AeroGlide SERVER — Environment Variables Example
# ============================================================

PORT=5000
NODE_ENV=development

# Supabase Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon (public) key
SUPABASE_ANON_KEY=your-anon-public-key-jwt-token

# Supabase Service Role key — server-side ONLY, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-private-jwt-token
