# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase Credentials (obtain from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-jwt-token
SUPABASE_SERVICE_ROLE_KEY=your-service-role-private-jwt-token

# Client Configuration (for Next.js compilation integration)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-jwt-token
NEXT_PUBLIC_API_URL=http://localhost:5000
